# Optional host overrides. These are not loaded automatically.
DSRF_SONIC_DIR=/tmp/GEAR-SONIC
DSRF_PLANNER_ONNX=/tmp/GEAR-SONIC/planner_sonic.onnx
DSRF_MOTION_GENERATOR=kinematic_planner
DSRF_DEVICE=cuda:0
DSRF_TASK=portrait-corridors
DSRF_VLM_URL=http://127.0.0.1:8080
DSRF_VLM_TIMEOUT=120
# DSRF_VLM_SYSTEM_PROMPT=prompt/SYSTEM.md
# DSRF_VLM_USER_PROMPT=prompt/USER.md
# DSRF_WAYPOINT_DEBUG=false
DSRF_IMAGE_WIDTH=640
DSRF_IMAGE_HEIGHT=480
DSRF_JPEG_QUALITY=85
DSRF_VIEWER=native
DSRF_REFERENCE_GHOST=false
# ARDY closed-loop values:
# CHECKPOINTS_DIR=/path/to/ardy/checkpoints
# DSRF_TEXT_ENCODER_MODEL=/path/to/local/model
